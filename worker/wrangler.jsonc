{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dsh-remote",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": { "bindings": [{ "name": "HUB", "class_name": "Hub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*", "/health", "/healthz", "/ready"]
  },
  "vars": {
    "DSH_SITE_NAME": "DSH Remote",
    "ADMIN_ACCOUNTS": "xcq0607@gmail.com",
    "DSH_HEARTBEAT_MS": "25000",
    "DSH_HELLO_TIMEOUT_MS": "5000",
    "DSH_HEARTBEAT_DISCONNECT_MS": "75000",
    "DSH_MAX_FRAMES_PER_SEC": "512",
    "DSH_MAX_CONNECTIONS": "256",
    "DSH_MAX_DEVICES_PER_ACCOUNT": "256",
    "DSH_SESSION_HOURS": "8",
    "DSH_TURN_ENABLED": "true",
    "DSH_TURN_TTL_SECONDS": "300",
    "DSH_STUN_URLS": "stun:stun.miwifi.com:3478,stun:stun.chat.bilibili.com:3478,stun:stun.cloudflare.com:443",
    "DSH_ALLOWED_ORIGINS": "",
    "DSH_DO_LOCATION": ""
  },
  "observability": { "enabled": true }
}
